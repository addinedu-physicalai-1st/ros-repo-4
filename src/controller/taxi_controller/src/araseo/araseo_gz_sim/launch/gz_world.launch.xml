<?xml version='1.0' ?>
<launch>
    <arg name="use_sim_time" default="True"/>
    <arg name="bridge_params" default="$(find-pkg-share araseo_gz_sim)/params/pinky_bridge.yaml"/>
    <arg name="world_path" default="$(find-pkg-share araseo_gz_sim)/worlds/minicity.sdf"/>

    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share pinky_description)/../:/$(find-pkg-share araseo_gz_sim)/models:/$(env HOME)/.gazebo/models"/>
    <set_env name="RCUTILS_LOGGING_USE_SIMTIME" value="1"/>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-r -v4 $(var world_path)"/>
        <arg name="on_exit_shutdown" value="true"/>
    </include>

    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="clock_bridge">
        <param name="config_file" value="$(var bridge_params)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
</launch>
