<?xml version="1.0"?>
<sdf version="1.9">
  <world name="araseo_minicity_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.75 0.8 1</background>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 2.5 0 1.5708 0</pose>
      </camera>
    </gui>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.25 0.25 0.22 1</ambient><diffuse>0.25 0.25 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://minicity_floor</uri>
      <name>minicity_floor</name>
      <pose>0 0 0.001 0 0 0</pose>
    </include>

    <model name="wall_n">
      <static>true</static>
      <pose>0 0.700 0.10 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.860 0.01 0.200</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.860 0.01 0.200</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metal>
              <albedo_map>model://minicity_walls/materials/wall_n_street.png</albedo_map>
              <roughness>1.0</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>0 -0.700 0.10 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.860 0.01 0.200</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.860 0.01 0.200</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metal>
              <albedo_map>model://minicity_walls/materials/wall_s_street.png</albedo_map>
              <roughness>1.0</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>0.930 0 0.10 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.01 1.400 0.200</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.01 1.400 0.200</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metal>
              <albedo_map>model://minicity_walls/materials/wall_e_street.png</albedo_map>
              <roughness>1.0</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-0.930 0 0.10 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.01 1.400 0.200</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.01 1.400 0.200</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metal>
              <albedo_map>model://minicity_walls/materials/wall_w_street.png</albedo_map>
              <roughness>1.0</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
