<?xml version='1.0' ?>
<launch>
    <arg name="rviz_config_file" default="$(find-pkg-share araseo_navigation)/rviz/route_editor.rviz"/>
    <arg name="map" description="Full path to the map.yaml file to load"/>
    <arg name="use_sim_time" default="False"/>
    <arg name="rviz_fullscreen" default="false"/>
    <arg name="rviz_extra_args" default=""/>

    <let name="rviz_fullscreen_arg" value="--fullscreen" if="$(var rviz_fullscreen)"/>
    <let name="rviz_fullscreen_arg" value="" unless="$(var rviz_fullscreen)"/>

    <node
        pkg="rviz2"
        exec="rviz2"
        output="screen"
        args="-d $(var rviz_config_file) $(var rviz_fullscreen_arg) $(var rviz_extra_args)">
        <param name="use_sim_time" value="$(var use_sim_time)" type="bool"/>
    </node>

    <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
        <param name="yaml_filename" value="$(var map)"/>
        <param name="use_sim_time" value="$(var use_sim_time)" type="bool"/>
    </node>

    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_map" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)" type="bool"/>
        <param name="autostart" value="true"/>
        <param name="node_names" value="['map_server']"/>
    </node>
</launch>
