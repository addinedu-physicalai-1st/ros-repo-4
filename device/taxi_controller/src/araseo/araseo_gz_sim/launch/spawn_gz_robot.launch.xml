<?xml version='1.0' ?>
<launch>
    <arg name="pinky_id" default="54"/>
    <arg name="use_sim_time" default="True"/>
    <arg name="cam_tilt_deg" default="25"/>
    <arg name="bridge_params" default="$(find-pkg-share araseo_gz_sim)/params/pinky_bridge.yaml"/>
    <arg name="pinky_params" default="$(find-pkg-share pinky_bringup)/config/pinky_params.yaml"/>
    <arg name="spawn_x" default="0.0"/>
    <arg name="spawn_y" default="0.0"/>
    <arg name="spawn_z" default="0.0"/>
    <arg name="spawn_yaw" default="0"/>

    <!-- Derived variables equivalent to build_robot_identity -->
    <let name="pinky_id_int" value="$(eval 'int(\'$(var pinky_id)\' or \'0\') &amp; 0xFF')"/>
    <let name="namespace" value="pinky_$(var pinky_id_int)"/>
    <let name="robot_name" value="$(var namespace)_pinky"/>
    
    <let name="map_frame_id" value="map"/>
    <let name="odom_frame_id" value="$(var namespace)/odom"/>
    <let name="base_frame_id" value="$(var namespace)/base_footprint"/>

    <!-- Robot Description & State Publisher -->
    <include file="$(find-pkg-share pinky_description)/launch/upload_robot.launch.py">
        <arg name="namespace" value="$(var namespace)"/>
        <arg name="is_sim" value="$(var use_sim_time)"/>
        <arg name="cam_tilt_deg" value="$(var cam_tilt_deg)"/>
    </include>

    <!-- Spawn Robot Entity -->
    <node pkg="ros_gz_sim" exec="create" name="$(var namespace)_create"
          args="-name $(var robot_name) -topic /$(var namespace)/robot_description -x $(var spawn_x) -y $(var spawn_y) -z $(var spawn_z) -Y $(var spawn_yaw)">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- Global clock bridge (using static config file) -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="parameter_bridge">
        <param name="config_file" value="$(var bridge_params)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <group>
        <push-ros-namespace namespace="$(var namespace)"/>

        <!-- Namespaced bridges for robot-specific topics -->
        <node pkg="ros_gz_bridge" exec="parameter_bridge" name="namespaced_parameter_bridge"
              args="/$(var namespace)/odom@nav_msgs/msg/Odometry[gz.msgs.Odometry /$(var namespace)/scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan /$(var namespace)/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist /$(var namespace)/joint_states@sensor_msgs/msg/JointState[gz.msgs.Model /tf@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V /$(var namespace)/camera/camera_info@sensor_msgs/msg/CameraInfo[gz.msgs.CameraInfo">
            <param name="use_sim_time" value="$(var use_sim_time)"/>
        </node>

        <!-- Gazebo Model Pose Bridge -->
        <node pkg="ros_gz_bridge" exec="parameter_bridge" name="gps_pose_bridge"
              args="/model/$(var robot_name)/pose@geometry_msgs/msg/PoseStamped[gz.msgs.Pose">
            <param name="use_sim_time" value="$(var use_sim_time)"/>
            <remap from="/model/$(var robot_name)/pose" to="gazebo/pose"/>
        </node>

        <!-- Gazebo GPS Publisher (converts Gazebo pose to PinkyGps) -->
        <node pkg="araseo_gz_sim" exec="gazebo_gps_publisher.py" name="gazebo_gps_publisher">
            <param from="$(var pinky_params)"/>
            <param name="use_sim_time" value="$(var use_sim_time)"/>
            <param name="pinky_id" value="$(var pinky_id_int)"/>
        </node>

        <!-- GPS Odometry Calibrator (Localizes robot using GPS + Odom) -->
        <node pkg="pinky_bringup" exec="gps_odometry_calibrator" name="gps_odometry_calibrator">
            <param from="$(var pinky_params)"/>
            <param name="use_sim_time" value="$(var use_sim_time)"/>
            <param name="namespace" value="$(var namespace)"/>
            <param name="map_frame_id" value="$(var map_frame_id)"/>
            <param name="odom_frame_id" value="$(var odom_frame_id)"/>
            <param name="base_frame_id" value="$(var base_frame_id)"/>
        </node>

        <!-- Image Bridges -->
        <node pkg="ros_gz_image" exec="image_bridge" name="image_bridge_raw"
              args="/$(var namespace)/camera/image_raw">
            <param name="use_sim_time" value="$(var use_sim_time)"/>
            <remap from="/$(var namespace)/camera/image_raw" to="camera/image_raw"/>
        </node>

        <node pkg="ros_gz_image" exec="image_bridge" name="image_bridge"
              args="/$(var namespace)/camera">
            <param name="use_sim_time" value="$(var use_sim_time)"/>
            <remap from="/$(var namespace)/camera" to="camera"/>
        </node>
    </group>
</launch>
