<?xml version='1.0' ?>

<launch>
    <arg name="pinky_id" default=""/>
    <arg name="use_sim_time" default="True"/>
    <arg name="cam_tilt_deg" default="25"/>
    <arg name="bridge_params" default="$(find-pkg-share araseo_gz_sim)/params/pinky_bridge.yaml"/>
    <arg name="pinky_params" default="$(find-pkg-share pinky_bringup)/config/pinky_params.yaml"/>
    <arg name="spawn_x" default="0.0"/>
    <arg name="spawn_y" default="0.0"/>
    <arg name="spawn_z" default="0.0"/>
    <arg name="spawn_yaw" default="0"/>

    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share pinky_description)/../:/$(find-pkg-share araseo_gz_sim)/models:/$(env HOME)/.gazebo/models"/>
    <set_env name="RCUTILS_LOGGING_USE_SIMTIME" value="1"/>

    <include file="$(find-pkg-share araseo_gz_sim)/launch/launch_sim.launch.py">
        <arg name="pinky_id" value="$(var pinky_id)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="cam_tilt_deg" value="$(var cam_tilt_deg)"/>
        <arg name="bridge_params" value="$(var bridge_params)"/>
        <arg name="pinky_params" value="$(var pinky_params)"/>
        <arg name="spawn_x" value="$(var spawn_x)"/>
        <arg name="spawn_y" value="$(var spawn_y)"/>
        <arg name="spawn_z" value="$(var spawn_z)"/>
        <arg name="spawn_yaw" value="$(var spawn_yaw)"/>
    </include>
</launch>
